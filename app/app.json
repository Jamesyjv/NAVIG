{
  "expo": {
    "name": "NAVIG",
    "slug": "navig",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.navig.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.navig.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080C14"
      },
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#080C14"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "placeholder-eas-project-id"
      },
      "apiUrl": "https://navig-api.onrender.com"
    }
  }
}
